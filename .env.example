# Copy to .env. Never commit the real .env.

# ---------- Python core ----------
# Leave ANTHROPIC_API_KEY empty to run in MOCK_MODE (offline rules engine, $0).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Re-run a lead once on this model when the primary is unsure or fails twice. Empty disables escalation.
ESCALATION_MODEL=claude-sonnet-5-5
ESCALATION_CONFIDENCE_THRESHOLD=0.6
# auto = mock when no API key; true = always mock; false = live
MOCK_MODE=auto
# Thinking effort for the agent: low | medium | high
ANTHROPIC_EFFORT=low
# Retry a declined request on Anthropic's recommended fallback model (server side).
# Only sent to models that support it (not Haiku).
ANTHROPIC_SERVER_SIDE_FALLBACK=true
# Cost and quality levers
PROMPT_CACHING=true
FEW_SHOT_EXAMPLES=true
RULES_PREFILTER=true
MAX_OUTPUT_TOKENS=1500
# Leave empty: current Claude models (Haiku 5.5, Sonnet 5.5) reject non-default temperature with a 400.
# Only sent to older models that accept it.
TEMPERATURE=
# Comma-separated keys accepted in the X-API-Key header. Empty disables auth (local only).
API_KEYS=dev-key-change-me
RATE_LIMIT_PER_MINUTE=60
# Comma-separated browser origins allowed to call the API (the demo form runs on :8080)
CORS_ORIGINS=http://localhost:8080
# Let the agent fetch the company homepage title (3 second timeout, public hosts only)
ENABLE_HOMEPAGE_FETCH=false
LOG_LEVEL=INFO
# Optional: point at a client-specific rules file
# SCORING_RULES_PATH=/srv/config/scoring_rules.yaml

# ---------- Node worker ----------
PORT=3000
CORE_API_KEY=dev-key-change-me
# Optional shared secret callers must send as X-Webhook-Secret
WEBHOOK_SECRET=
# Google OAuth client + refresh token (scopes: spreadsheets, gmail.compose).
# Leave empty to use console adapters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=Leads!A1
SLACK_WEBHOOK_URL=
DRAFT_SUBJECT=Thanks for getting in touch

# ---------- n8n ----------
GENERIC_TIMEZONE=UTC
N8N_WEBHOOK_URL=http://localhost:5678/
